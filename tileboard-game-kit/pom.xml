<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tileboard</groupId>
    <artifactId>tileboard-game-kit</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Tileboard Game Kit</name>
    <description>
        Framework-free, thread-safe library of reusable game-building blocks
        (touch tracking, movement patterns, neighbors/connectivity, score and
        health state, timers, multiplayer rosters, reaction timing, rhythm
        sequencing, memory/reveal challenges). Depends only on
        tileboard-serial-protocol (for Board/Position) and slf4j-api - no
        Spring, no I/O, no knowledge of any single game. Concrete games
        (in tileboard-app, or any other consumer) compose these blocks
        instead of re-implementing the same timing/thread-safety/scoring
        logic per game. New capabilities are added as new, independent
        classes - nothing here is a switch statement that must grow.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.11.0</junit.version>
        <slf4j.version>2.0.16</slf4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tileboard</groupId>
            <artifactId>tileboard-serial-protocol</artifactId>
            <version>1.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </build>
</project>
