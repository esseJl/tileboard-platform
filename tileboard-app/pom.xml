<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.tileboard</groupId>
    <artifactId>tileboard-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Tileboard Application</name>
    <description>
        Spring Boot web application that drives an LED tile board over
        serial, built on top of the transport-agnostic tileboard-serial-protocol
        library. Game logic, security and persistence are intentionally left
        as extension points at this stage - see README.md.
    </description>

    <properties>
        <java.version>17</java.version>
        <jserialcomm.version>2.11.0</jserialcomm.version>
    </properties>

    <dependencies>
        <!-- Our own transport-agnostic protocol/gateway library -->
        <dependency>
            <groupId>com.tileboard</groupId>
            <artifactId>tileboard-serial-protocol</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.tileboard</groupId>
            <artifactId>tileboard-game-engine</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!--
            jSerialComm is an optional dependency of tileboard-serial-protocol.
            The application is the one talking to real hardware, so it is the
            application's responsibility to pull it in.
        -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            Read-only health/info endpoints for load balancers, container
            orchestrators (k8s liveness/readiness probes) and ops monitoring.
            No write/actuator-management endpoints are exposed - see
            application.yml's management.endpoints.web.exposure.include.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            2.0.2 predates Spring Boot 3.3's Spring Framework version and can
            fail to start (NoSuchMethodError / incompatible auto-configuration)
            against it; 2.6.0 is the first line verified against Boot 3.3.x.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
